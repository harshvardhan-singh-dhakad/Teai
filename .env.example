# AI provider keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# GPT-Live voice testing (server-side key only)
OPENAI_LIVE_MODEL=gpt-live-1

# Firebase Admin uses Google Cloud application credentials at runtime
FIREBASE_PROJECT_ID=teai-ai-voice-agent-platform

# Telephony provider configuration (server-side only)
TELEPHONY_PROVIDER=exotel
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_API_BASE_URL=https://api.exotel.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_BASE_URL=https://api.twilio.com

# Public application URL
NEXT_PUBLIC_BASE_URL=http://localhost:9002
