
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is the owner of a document.
    function isOwner(resource) {
      return request.auth.uid == resource.data.ownerId;
    }

    // Rules for the 'agents' collection
    match /agents/{agentId} {
      // Any authenticated user can create an agent.
      allow create: if request.auth != null;

      // Any authenticated user can read agents.
      allow read: if request.auth != null;

      // Only the owner of the agent can update or delete it.
      allow update, delete: if request.auth != null && isOwner(resource);
    }
    
    // Rules for the 'chatLogs' collection
    match /chatLogs/{logId} {
        // Any authenticated user can create a chat log.
        allow create: if request.auth != null;

        // By default, deny read, update, and delete access to chat logs 
        // to protect user privacy. Adjust these rules based on your app's needs,
        // for example, allowing users to view their own chat history.
        allow read, update, delete: if false;
    }

    // Default deny rule for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
